# Environment Variables
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://recruituser:recruitpassword@localhost:5432/recruitdb"

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# n8n Webhooks
N8N_WEBHOOK_INTERVIEW_SCHEDULED=
N8N_INTERVIEW_DECISION_URL=

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@recruit.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Super Admin
